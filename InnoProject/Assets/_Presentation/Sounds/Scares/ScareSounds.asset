  slots:
  - name: babaika_descend
    description: "\u0428\u043E\u0440\u043E\u0445 \u0438 \u0441\u043A\u0440\u0435\u0436\u0435\u0442,
      \u043F\u043E\u043A\u0430 \u0431\u0430\u0431\u0430\u0439\u043A\u0430 \u0441\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043F\u043E\u0442\u043E\u043B\u043A\u0430 \u0432 \u043A\u0430\u0442\u0441\u0446\u0435\u043D\u0435
      (3D)."
    clips: []
    volume: 0.9
    pitch: {x: 1, y: 1}
    placeholder: 5
  - name: babaika_scream
    description: "\u0415\u0451 \u0432\u043E\u043F\u043B\u044C \u0432 \u043A\u043E\u043D\u0446\u0435
      \u0441\u043F\u0443\u0441\u043A\u0430, \u043F\u0440\u044F\u043C\u043E \u043F\u0435\u0440\u0435\u0434
      \u043F\u043E\u0433\u043E\u043D\u0435\u0439 (3D)."
    clips: []
    volume: 1
    pitch: {x: 1, y: 1}
    placeholder: 3
  - name: babaika_chase_loop
    description: "\u041F\u0435\u0442\u043B\u044F: \u0445\u0440\u0438\u043F \u0438
      \u0441\u043A\u0440\u0435\u0436\u0435\u0442 \u0431\u0430\u0431\u0430\u0439\u043A\u0438,
      \u043F\u043E\u043A\u0430 \u043E\u043D\u0430 \u0433\u043E\u043D\u0438\u0442\u0441\u044F
      (3D, \u0437\u0432\u0443\u0447\u0438\u0442 \u043E\u0442 \u043D\u0435\u0451)."
    clips: []
    volume: 0.8
    pitch: {x: 1, y: 1}
    placeholder: 0
  - name: babaika_claws
    description: "\u0429\u0435\u043B\u0447\u043E\u043A \u043A\u043E\u0433\u0442\u0435\u0439
      \u043F\u043E \u043F\u043E\u043B\u0443 \u0438 \u0441\u0442\u0435\u043D\u0430\u043C
      \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0435\u0451 \u0448\u0430\u0433\u0435
      (3D). \u041F\u0443\u0441\u0442\u043E: \u0431\u0435\u0442\u043E\u043D\u043D\u044B\u0435
      \u0448\u0430\u0433\u0438 \u0432\u044B\u0448\u0435 \u0442\u043E\u043D\u043E\u043C."
    clips: []
    volume: 0.6
    pitch: {x: 1, y: 1}
    placeholder: 0
  - name: chase_music
    description: "\u041F\u0435\u0442\u043B\u044F: \u043C\u0443\u0437\u044B\u043A\u0430
      \u0438\u043B\u0438 \u0433\u0443\u043B \u043F\u043E\u0433\u043E\u043D\u0438
      (2D)."
    clips: []
    volume: 0.6
    pitch: {x: 1, y: 1}
    placeholder: 6
  - name: heartbeat
    description: "\u041F\u0435\u0442\u043B\u044F: \u0441\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043D\u0438\u0435,
      \u0433\u0440\u043E\u043C\u0447\u0435 \u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
      \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0431\u043B\u0438\u0437\u043A\u043E
      (2D)."
    clips: []
    volume: 0.8
    pitch: {x: 1, y: 1}
    placeholder: 4
  - name: door_slam
    description: "\u0414\u0432\u0435\u0440\u044C \u0441 \u0441\u0438\u043B\u043E\u0439
      \u0437\u0430\u0445\u043B\u043E\u043F\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0437\u0430 \u0438\u0433\u0440\u043E\u043A\u043E\u043C \u043D\u0430 1 \u0443\u0440\u043E\u0432\u043D\u0435
      (3D)."
    clips: []
    volume: 1
    pitch: {x: 1, y: 1}
    placeholder: 2
  - name: door_bang
    description: "\u0411\u0430\u0431\u0430\u0439\u043A\u0430 \u0431\u044C\u0451\u0442\u0441\u044F
      \u0432 \u0437\u0430\u0445\u043B\u043E\u043F\u043D\u0443\u0442\u0443\u044E \u0434\u0432\u0435\u0440\u044C,
      \u043B\u0443\u0447\u0448\u0435 3-4 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
      (3D)."
    clips: []
    volume: 1
    pitch: {x: 1, y: 1}
    placeholder: 1
  - name: screamer
    description: "\u0421\u043A\u0440\u0438\u043C\u0435\u0440, \u043A\u043E\u0433\u0434\u0430
      \u043E\u043D\u0430 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0438\u0433\u0440\u043E\u043A\u0430
      (2D, \u0433\u0440\u043E\u043C\u043A\u043E)."
    clips: []
